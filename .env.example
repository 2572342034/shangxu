# ============ 商序云 部署环境变量 ============
# 复制为 .env 后按需修改

# MySQL root 密码（同时用于后端连接）
MYSQL_ROOT_PASSWORD=root

# 宿主机端口映射（避免与本机已占用端口冲突）
MYSQL_PORT=3307
REDIS_PORT=6380
WEB_PORT=80
# 后端已改为经 Nginx 统一入口（backend1/backend2 负载均衡），不再对外暴露端口
# BACKEND_PORT=8080

# JWT 密钥，生产环境务必替换（长度 >= 32）
CRM_JWT_SECRET=CHANGE_ME_BEFORE_DEPLOY_AT_LEAST_32_CHARS_LONG

# 允许跨域的前端地址，多个用逗号分隔
CRM_CORS_ORIGINS=http://localhost,http://localhost:80

# 附件存储目录（容器内路径，对应 shangxu-uploads 卷）
CRM_UPLOAD_DIR=/app/data/uploads

# 定时任务：逾期应收/跟进提醒/公海回收。多实例部署时只开一个实例
CRM_SCHEDULER_ENABLED=true
# 私海客户超过 N 天未跟进自动回收，0 表示关闭
CRM_POOL_RECYCLE_DAYS=30

# 后端 JVM 参数（含空格，必须用引号）
JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC"
